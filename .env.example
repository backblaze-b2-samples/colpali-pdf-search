# Backblaze B2 (required) — S3-compatible API
B2_APPLICATION_KEY_ID=your_application_key_id
B2_APPLICATION_KEY=your_application_key
B2_BUCKET_NAME=your-bucket-name
B2_REGION=your-region

# Optional. Only needed to build public object URLs for a public bucket; the
# app works without it (page images are served via presigned URLs instead).
# B2_PUBLIC_URL_BASE=https://your-bucket.s3.your-region.backblazeb2.com

# Example of the SHAPE of each value (placeholders — not real credentials):
# B2_APPLICATION_KEY_ID=<25-char key id from the B2 dashboard>
# B2_APPLICATION_KEY=<application key, shown once when you create the key>
# B2_BUCKET_NAME=my-colpali-corpus
# B2_REGION=us-west-004   (the region segment of your bucket's S3 endpoint)

# ColPali model (optional — runs locally, no provider key).
# vidore/colpali-v1.2 is the default; its PaliGemma base is HF-gated.
# vidore/colqwen2-v1.0 is ungated and lighter.
# COLPALI_MODEL=vidore/colpali-v1.2
# Device autodetect: CUDA -> CPU (MPS skipped by default; set to mps to force).
# COLPALI_DEVICE=cpu
# One-time Hugging Face token for downloading gated model weights (NOT a
# per-request provider key). Not needed for the ungated colqwen2 model.
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Frontend → API base URL. Defaults to http://localhost:8000 for local dev;
# set this to the deployed API origin in production (Next.js inlines it at
# build time, so it must be present when `pnpm build` runs).
# NEXT_PUBLIC_API_URL=https://your-api.example.com
